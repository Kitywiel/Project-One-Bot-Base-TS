# minecraft acount
MC_HOST= localhost # Always Required
MC_PORT= 25565     # Always needed if proxy is filled in
MC_USERNAME= bot   # Always Required

# passcode is needed if the server requires one in offline mode
# auth potions > offline | microsoft | mojang < if not set it defalts to offline
MC_AUTH= offline
MC_PASSCODE= YourPasscodeHere123!

# Proxy connection

# not needed to connect with out an proxy
PROXY_HOST=       # NEEDS TO BE SET IF USING AN PROXY
PROXY_PORT=       # NEEDS TO BE SET IF USING AN PROXY
PROXY_USERNAME=   # only needed if your proxy provider requires it
PROXY_PASSCODE=   # only needed if your proxy provider requires it
